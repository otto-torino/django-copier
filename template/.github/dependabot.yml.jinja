version: 2
updates:
  - package-ecosystem: github-actions
    directory: /
    schedule:
      interval: weekly
    groups:
      github-actions:
        patterns:
          - "*"

  - package-ecosystem: pip
    directory: /[[ repo_name ]]
    schedule:
      interval: weekly
    ignore:
      # django-baton supports up to Django 6.0: 6.1 breaks the admin breadcrumbs
      - dependency-name: django
        versions: [">=6.1"]
    groups:
      python:
        patterns:
          - "*"

  - package-ecosystem: npm
    directory: /[[ repo_name ]]/theme/static_src
    schedule:
      interval: weekly
    groups:
      frontend:
        patterns:
          - "*"
