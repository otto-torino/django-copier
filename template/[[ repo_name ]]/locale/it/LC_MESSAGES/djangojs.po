# The strings of the admin JS widgets that Django leaves untranslated in Italian.
# Without an article, and without an adjective agreeing with the %s, so that one sentence serves
# authors, editors, topics and areas; the strings that drop the %s lose the javascript-format
# flag, or msgfmt --check-format would want it back.
msgid ""
msgstr ""
"Project-Id-Version: \n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: it\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgid ""
"Choose %s by selecting them and then select the \"Choose\" arrow button."
msgstr "Seleziona le voci da scegliere e premi la freccia verso destra."

msgid "Choose all %s"
msgstr "Scegli tutto"

msgid "Choose selected %s"
msgstr "Scegli la selezione"

msgid "Remove selected %s"
msgstr "Rimuovi la selezione"

msgid ""
"Remove %s by selecting them and then select the \"Remove\" arrow button."
msgstr "Seleziona le voci da rimuovere e premi la freccia verso sinistra."

msgid "(click to clear)"
msgstr "(fai clic per azzerare il filtro)"

msgid "Remove all %s"
msgstr "Rimuovi tutto"

#, javascript-format
msgid "Available %s"
msgstr "Disponibili: %s"

#, javascript-format
msgid "Chosen %s"
msgstr "Scelti: %s"

msgid "Type into this box to filter down the list of available %s."
msgstr "Scrivi in questa casella per filtrare l'elenco delle voci disponibili."

msgid "Type into this box to filter down the list of selected %s."
msgstr "Scrivi in questa casella per filtrare l'elenco delle voci scelte."
