from datetime import timedelta

from django.contrib.auth import get_user_model
from django.contrib.sites.models import Site
from django.test import TestCase
from django.urls import reverse
from django.utils import timezone

from .models import NewsArticle


class NewsArticleTests(TestCase):
    def setUp(self):
        self.site = Site.objects.get_current()
        self.site.domain = "testserver"
        self.site.save()
        Site.objects.clear_cache()

    def create_article(self, **overrides):
        values = {
            "title": "Published article",
            "slug": "published-article",
            "publication_date": timezone.localdate(),
            "status": NewsArticle.PUBLISHED,
        }
        values.update(overrides)
        article = NewsArticle.objects.create(**values)
        article.sites.add(self.site)
        return article

    def test_list_hides_drafts_and_scheduled_articles(self):
        published = self.create_article()
        self.create_article(title="Draft", slug="draft", status=NewsArticle.DRAFT)
        self.create_article(
            title="Scheduled",
            slug="scheduled",
            publication_date=timezone.localdate() + timedelta(days=1),
        )

        response = self.client.get(reverse("news:list"))

        self.assertEqual(list(response.context["object_list"]), [published])

    def test_auth_required_article_is_private_but_available_after_login(self):
        article = self.create_article(auth_required=True)

        anonymous = self.client.get(article.get_absolute_url())
        user = get_user_model().objects.create_user("reader", password="password")
        self.client.force_login(user)
        authenticated = self.client.get(article.get_absolute_url())

        self.assertEqual(anonymous.status_code, 404)
        self.assertEqual(authenticated.status_code, 200)

    def test_sitemap_only_contains_public_articles(self):
        from .sitemap import NewsArticleSitemap

        public = self.create_article()
        self.create_article(title="Private", slug="private", auth_required=True)

        self.assertEqual(list(NewsArticleSitemap().items()), [public])
