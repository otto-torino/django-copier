    class Shape(models.TextChoices):
        POINT = "POINT", _("Point")
        POLYLINE = "POLYLINE", _("Polyline")
        POLYGON = "POLYGON", _("Polygon")
        CIRCLE = "CIRCLE", _("Circle")

