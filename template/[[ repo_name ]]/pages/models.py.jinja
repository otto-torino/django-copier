        verbose_name_plural = _("cards")
        ordering = ("position", "id")

    def __str__(self):
        """The first line of the text, which names the card in the admin."""
        title, _rest = self._split_first_line()
        if title:
            return title[:80]
        return "%s %s" % (pgettext_lazy("content block", "Card"), self.position)

    def _split_first_line(self):
        """The first line of the text, as plain text, and the text without it."""
        text = self.text or {}
        blocks = list(text.get("blocks", []))
        for index, block in enumerate(blocks):
            line = strip_tags(str(block.get("data", {}).get("text", ""))).strip()
            if line:
                return unescape(line), {**text, "blocks": blocks[:index] + blocks[index + 1:]}
        return "", text

    @property
    def accordion_title(self):
        return str(self)

    @property
    def accordion_text(self):
        """The text under the title of the accordion, which has its first line."""
        return self._split_first_line()[1]
