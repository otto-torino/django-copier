msgid ""
"Example: 'pages/contact_page.html'. If this isn't provided, the system will "
"use 'pages/default.html'."
msgstr ""
"Esempio: 'flatpages/contact_page.html'. Se non specificato, il sistema userà "
"'flatpages/default.html'."

#: models.py:46
