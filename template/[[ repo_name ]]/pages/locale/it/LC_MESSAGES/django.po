#: core/templates/core/widgets/map_drawer.html
msgid "Search an address or a place"
msgstr "Cerca un indirizzo o un luogo"

msgid "Search"
msgstr "Cerca"

msgid "No place found."
msgstr "Nessun luogo trovato."

msgid "The search is not available right now."
msgstr "La ricerca ora non è disponibile."

msgid ""
"Draw with the tools on the left: move the map, drag the shape and its "
"vertices to fix it. Search an address to go there."
msgstr ""
"Disegna con gli strumenti a sinistra: trascina la forma e i suoi vertici "
"per correggerla. Cerca un indirizzo per spostarti lì."

msgid "Coordinates"
msgstr "Coordinate"


#: models.py
msgid "only inside columns"
msgstr "solo dentro le colonne"

#: models.py
msgid "the block is not shown on its own: place it in a column of a columns block"
msgstr "il blocco non viene mostrato da solo: mettilo in una colonna di un blocco colonne"

#: models.py
msgid "The link contains invalid characters."
msgstr "Il link contiene caratteri non validi."

#: models.py
msgid "Enter a valid link."
msgstr "Inserisci un link valido."

#: models.py
msgid "Links must be relative URLs or use HTTP or HTTPS."
msgstr "I link devono essere URL relativi oppure usare HTTP o HTTPS."

#: models.py
msgid "video link or id"
msgstr "link o id del video"

#: models.py
msgid "Paste the link of the video: the platform is recognised by itself. Or write its id: for YouTube the code after v=, for Vimeo the number, followed by ?h= and its code for an unlisted video, for Twitch clip= and the name of the clip."
msgstr "Incolla il link del video: la piattaforma viene riconosciuta da sola. Oppure scrivi il suo id: per YouTube il codice dopo v=, per Vimeo il numero, seguito da ?h= e dal suo codice per un video non in elenco, per Twitch clip= e il nome della clip."

#: models.py
msgid "This is not a link to a YouTube, Vimeo or Twitch video."
msgstr "Questo non è il link di un video di YouTube, Vimeo o Twitch."

