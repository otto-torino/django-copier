#: templates/includes/consent_note.html:16
#, python-format
msgid ""
"The %(platform)s content is not displayed because it uses third-party "
"cookies: it is loaded once they are accepted in the cookie settings."
msgstr ""
"Il contenuto di %(platform)s non è visibile perché utilizza cookie di terze "
"parti: viene caricato dopo il consenso nelle impostazioni dei cookie."

#: templates/includes/consent_note.html:16
#, python-format
