# DEBUG_TOOLBAR
JQUERY_URL = ''

def show_toolbar(request):
    from core.local_middleware import is_editor_page

    if request.headers.get('x-requested-with') == 'XMLHttpRequest':
        return False
    # the editors are pages of their own, as many as the forms have
    return not is_editor_page(request)

DEBUG_TOOLBAR_CONFIG = {
    'SHOW_TOOLBAR_CALLBACK': show_toolbar,
}
