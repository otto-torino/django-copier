from baton.fields import BatonAiImageField
from django.contrib.auth.models import AbstractUser
from django.db import models
from django.utils.translation import gettext_lazy as _
from preferences_utils.models import PreferencesUtilsModel

from .fields import AltTextField, SubjectLocationField


# custom user model just in case we need to add functionality
class User(AbstractUser):
    pass


def ai_models_default():
    return {
        "TRANSLATIONS": "gpt-4o",
        "SUMMARIZATIONS": "gpt-3.5-turbo",
        "CORRECTIONS": "gpt-3.5-turbo",
        "IMAGES": "dall-e-3",
    }


@PreferencesUtilsModel.register("pref")
class Preferences(PreferencesUtilsModel):
    ai_models = models.JSONField(_("ai models"), default=ai_models_default)
    hide_archived = models.BooleanField(
        verbose_name=_("hide archived"), default=False
    )
    robots = models.TextField(_("robots"), default="", blank=True)

    site_title = models.CharField(
        _("site title"),
        max_length=100,
        default=[[ project_name | tojson ]],
        blank=True,
    )

    meta_title = models.CharField(
        _("meta title"),
        max_length=100,
        default=[[ project_name | tojson ]],
        blank=True,
    )
    meta_description = models.CharField(
        _("meta description"),
        max_length=300,
        default=[[ project_description | tojson ]],
        blank=True,
    )
    meta_image = BatonAiImageField(
        _("meta image"), upload_to="preferences/", blank=True, null=True,
        subject_location_field="meta_image_subject_location",
        alt_field=[%% if use_translations %%]"meta_image_alt_text_[[ default_language | replace("-", "_") ]]"[%% else %%]"meta_image_alt_text"[%% endif %%],
    )
    meta_image_subject_location = SubjectLocationField()
    meta_image_alt_text = AltTextField(_("alt text"), blank=True)
    meta_keywords = models.CharField(
        _("meta keywords"), max_length=255, blank=True, null=True
    )

    class Meta:
        verbose_name = _("preference")
        verbose_name_plural = _("preferences")
